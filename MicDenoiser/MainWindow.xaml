                                                    <Expander Header="{DynamicResource Advanced}" Foreground="{DynamicResource Ink}"><StackPanel Margin="0,8,0,0"><Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{DynamicResource Frequency}" Style="{StaticResource Label}"/>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBox FlowDirection="LeftToRight" Width="54" Padding="4,2" Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Line}" KeyDown="MixerNumber_KeyDown" Text="{Binding Value, ElementName=EqBodyHzSlider, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, StringFormat={}{0:0}}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <Slider x:Name="EqBodyHzSlider" Minimum="200" Maximum="1800" ValueChanged="Param_Changed"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{DynamicResource EqQ}" Style="{StaticResource Label}"/>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBox FlowDirection="LeftToRight" Width="54" Padding="4,2" Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Line}" KeyDown="MixerNumber_KeyDown" Text="{Binding Value, ElementName=EqBodyQSlider, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, StringFormat={}{0:0.00}}"/>
