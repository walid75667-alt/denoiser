                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Ui059}" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Text="{DynamicResource Ui060}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" LineHeight="23"/>
                                        <TextBlock Text="{DynamicResource Ui061}" TextWrapping="Wrap" Style="{StaticResource Label}" Margin="0,12,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="{DynamicResource RecordTitle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,14,0,0">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource RecordTitle}" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Text="{DynamicResource RecordHint}" Style="{StaticResource Label}" TextWrapping="Wrap"/>
                                        <ProgressBar x:Name="ComparisonProgress" Maximum="10" Height="8" Margin="0,14"/>
                                        <TextBlock x:Name="ComparisonStatus" Style="{StaticResource Label}" TextWrapping="Wrap"/>
                                        <WrapPanel>
                                            <Button x:Name="RecordButton" Content="{DynamicResource RecordStart}" Style="{StaticResource PrimaryButton}" Click="RecordComparison_Click" Margin="0,0,8,8"/>
                                            <Button x:Name="CancelRecordButton" Content="{DynamicResource RecordCancel}" Style="{StaticResource SecondaryButton}" Click="CancelComparison_Click" Margin="0,0,0,8"/>
                                        </WrapPanel>
                                        <TextBlock Text="{DynamicResource PreviewDevice}" Style="{StaticResource Label}" Margin="0,14,0,8"/>
                                        <ComboBox x:Name="PreviewOutputCombo" Margin="0,0,0,14"/>
                                        <WrapPanel>
                                            <Button x:Name="PlayOriginalButton" Content="{DynamicResource PlayOriginal}" Click="PlayOriginal_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                                            <Button x:Name="PlayProcessedButton" Content="{DynamicResource PlayProcessed}" Click="PlayProcessed_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                                            <Button x:Name="StopPreviewButton" Content="{DynamicResource PreviewStop}" Click="StopPreview_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8"/>
                                        </WrapPanel>
                                        <WrapPanel>
                                            <Button x:Name="ExportOriginalButton" Content="{DynamicResource ExportOriginal}" Click="ExportOriginal_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                                            <Button x:Name="ExportProcessedButton" Content="{DynamicResource ExportProcessed}" Click="ExportProcessed_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8"/>
                                        </WrapPanel>
                                        <TextBlock Text="{DynamicResource ExportWavHint}" Style="{StaticResource Label}" TextWrapping="Wrap"/>
                                        <Border Background="{DynamicResource WarningSoft}" Padding="12" CornerRadius="8" Margin="0,10,0,0">
                                            <TextBlock Text="{DynamicResource PreviewWarning}" TextWrapping="Wrap" Foreground="{DynamicResource Ink}"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource AbTitle}" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Text="{DynamicResource AbHint}" Style="{StaticResource Label}" TextWrapping="Wrap"/>
                                        <WrapPanel>
                                            <Button x:Name="SaveAButton" Content="{DynamicResource SaveA}" Click="SaveA_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                                            <Button x:Name="SaveBButton" Content="{DynamicResource SaveB}" Click="SaveB_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                                            <Button x:Name="ApplyAButton" Content="{DynamicResource ApplyA}" Click="ApplyA_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                                            <Button x:Name="ApplyBButton" Content="{DynamicResource ApplyB}" Click="ApplyB_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                                            <Button x:Name="RenderAbButton" Content="{DynamicResource RenderAb}" Click="RenderAb_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                                            <Button x:Name="CancelAbButton" Content="{DynamicResource CancelAb}" Click="CancelAb_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                                            <Button x:Name="PlayAButton" Content="{DynamicResource PlayA}" Click="PlayA_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                                            <Button x:Name="PlayBButton" Content="{DynamicResource PlayB}" Click="PlayB_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                                        </WrapPanel>
                                        <TextBlock x:Name="AbStatus" Style="{StaticResource Label}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="{DynamicResource PreferencesTitle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,14,0,0">
                                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                    <ProgressBar x:Name="LoadingProgress" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,9"/>
                    <Button x:Name="ToggleButton" Style="{StaticResource PrimaryButton}" Height="48" Content="{DynamicResource Ui019}" Click="ToggleButton_Click"/>
                    <Button x:Name="TrayMinimizeButton" Style="{StaticResource SecondaryButton}" Content="{DynamicResource TrayMinimize}" Click="TrayMinimize_Click" Margin="0,9,0,0"/>
                    <CheckBox x:Name="MinimizeToTrayCheck" Click="MinimizeToTray_Click" Margin="0,10,0,0" ToolTip="{DynamicResource TrayKeepsAudio}">
                        <TextBlock Text="{DynamicResource TrayMinimizeOption}" TextWrapping="Wrap" FontSize="12" MaxWidth="244"/>
                    </CheckBox>
                    <TextBlock Text="{DynamicResource Ui020}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,9,0,0" FontSize="11"/>
                </StackPanel>
            <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource UsagePurpose}" Style="{StaticResource Label}"/>
                                        <ComboBox x:Name="UsagePurposeCombo" SelectionChanged="UsagePurpose_Changed" Margin="0,0,0,14"><ComboBoxItem Content="{DynamicResource UsageCalls}"/><ComboBoxItem Content="{DynamicResource UsageStudio}"/></ComboBox>
                                        <TextBlock x:Name="HotkeyStatus" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                        <Button Content="{DynamicResource About}" Click="About_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                                        <TextBlock Text="{DynamicResource PreferencesTitle}" Style="{StaticResource CardTitle}"/>
                                        <Button Content="{DynamicResource SetupTitle}" Click="Setup_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,0,0,18"/>
                                        <CheckBox x:Name="DarkThemeCheck" Content="{DynamicResource DarkTheme}" Click="Theme_Click" Margin="0,0,0,18"/>
                                        <CheckBox x:Name="StartupCheck" Click="Startup_Click" Margin="0,0,0,8">
                                            <TextBlock Text="{DynamicResource StartupOption}" TextWrapping="Wrap"/>
                                        </CheckBox>
                                        <TextBlock Text="{DynamicResource StartupHint}" Style="{StaticResource Label}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
        <Border x:Name="StudioFooter" Grid.Row="2" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,12">
            <TextBlock x:Name="StatusText" Text="{DynamicResource Ui062}" TextWrapping="Wrap" Style="{StaticResource Label}" Margin="0"/>
        </Border>
        <local:SimpleView x:Name="Compact" Grid.RowSpan="3" Visibility="Collapsed"/>
    </Grid>
</Window>
