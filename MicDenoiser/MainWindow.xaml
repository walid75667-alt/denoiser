<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MicDenoiser" x:Class="MicDenoiser.MainWindow" Title="MicDenoiser" Icon="/Assets/MicDenoiser.ico" Width="1220" Height="860" MinWidth="900" MinHeight="680" FlowDirection="RightToLeft" FontFamily="{DynamicResource InterfaceFont}" FontSize="13" Background="{DynamicResource Surface}" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border x:Name="StudioHeader" Background="{DynamicResource CardBg}" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel x:Name="BrandPanel" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Image Source="/Assets/MicDenoiser.png" Width="36" Height="36" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock x:Name="BrandText" Text="MicDenoiser" Foreground="{DynamicResource Ink}" FontSize="22" FontWeight="SemiBold" FlowDirection="LeftToRight" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Ui000}" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{DynamicResource SimpleMode}" Click="Simple_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                    <Button x:Name="StudioPowerButton" Click="ToggleButton_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                    <Button x:Name="StudioMuteButton" Click="Mute_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                    <ComboBox Visibility="Collapsed" x:Name="InterfaceModeCombo" Width="130" Margin="0,0,12,0" SelectionChanged="InterfaceMode_Changed" ToolTip="{DynamicResource InterfaceMode}">
                        <ComboBoxItem Content="{DynamicResource SimpleMode}"/>
                        <ComboBoxItem Content="{DynamicResource StudioMode}"/>
                    </ComboBox>
                    <ComboBox x:Name="LanguageCombo" Width="125" Margin="0,0,12,0" FlowDirection="LeftToRight" SelectionChanged="Language_Changed" ToolTip="Language / اللغة">
                        <ComboBoxItem Content="العربية" Tag="ar"/>
                        <ComboBoxItem Content="English" Tag="en"/>
                    </ComboBox>
                    <Border Background="#263D4D" CornerRadius="18" Padding="16,9" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#94A3B8" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusPill" Text="{DynamicResource Ui001}" Foreground="White" Margin="9,0,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
        <Grid x:Name="StudioBody" Grid.Row="1" Margin="18,16,18,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <Border x:Name="DeviceRecoveryPanel" Visibility="Collapsed" Background="{DynamicResource WarningSoft}" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource DeviceRecoveryTitle}" Style="{StaticResource CardTitle}"/>
                            <TextBlock x:Name="DeviceRecoveryText" TextWrapping="Wrap" Style="{StaticResource Label}"/>
                            <Button Content="{DynamicResource DeviceRecover}" Click="RecoverDevices_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="HealthBanner" Background="{DynamicResource AccentSoft}" CornerRadius="10" Padding="14,11" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock x:Name="HealthText" Text="{DynamicResource Ui021}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="HealthDetail" Text="{DynamicResource Ui022}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,4,0,0" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,0,12">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Ui023}" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="InDbText" Grid.Column="1" Text="— dBFS" Style="{StaticResource Value}"/>
                                </Grid>
                                <Border x:Name="InTrack" Height="12" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource Track}" FlowDirection="LeftToRight">
                                    <Grid>
                                        <Border Background="{StaticResource MeterGradient}"/>
                                        <Border x:Name="InMask" Background="{DynamicResource Track}" HorizontalAlignment="Right" Width="9999"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,12">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Ui024}" Style="{StaticResource Label}"/>
                                    <TextBlock x:Name="OutDbText" Grid.Column="1" Text="— dBFS" Style="{StaticResource Value}"/>
                                </Grid>
                                <Border x:Name="OutTrack" Height="12" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource Track}" FlowDirection="LeftToRight">
                                    <Grid>
                                        <Border Background="{StaticResource MeterGradient}"/>
                                        <Border x:Name="OutMask" Background="{DynamicResource Track}" HorizontalAlignment="Right" Width="9999"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="VoiceDot" Width="8" Height="8" Fill="#94A3B8" VerticalAlignment="Center"/>
                                <TextBlock x:Name="VoiceText" Text="{DynamicResource Ui025}" Style="{StaticResource Label}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="GateText" Grid.Column="1" Style="{StaticResource Value}"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <TabControl x:Name="MainTabs" Grid.Row="2" TabStripPlacement="Left">
                    <TabItem Header="{DynamicResource Ui026}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="SoundOptions" Margin="0,14,0,0">
                                <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Ui002}" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center"/>
                                    <Button x:Name="RefreshDevicesButton" Grid.Column="1" Content="{DynamicResource Ui003}" Style="{StaticResource SecondaryButton}" Click="RefreshDevices_Click" ToolTip="{DynamicResource Ui004}"/>
                                </Grid>
                                <TextBlock Text="{DynamicResource Ui005}" Style="{StaticResource Label}"/>
                                <ComboBox x:Name="InputCombo" Margin="0,0,0,16" ToolTip="{DynamicResource Ui006}"/>
                                <TextBlock Text="{DynamicResource Ui007}" Style="{StaticResource Label}"/>
                                <ComboBox x:Name="OutputCombo" Margin="0,0,0,10" ToolTip="{DynamicResource Ui008}" SelectionChanged="OutputDevice_Changed"/>
                                <Border Background="{DynamicResource AccentSoft}" CornerRadius="8" Padding="10">
                                    <TextBlock x:Name="RoutingText" Text="{DynamicResource Ui009}" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" FontSize="12"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Ui010}" Style="{StaticResource CardTitle}"/>
                                <CheckBox x:Name="FastSingingCheck" Content="{DynamicResource FastSinging}" Click="FastSinging_Click" Margin="0,0,0,8"/>
                                <TextBlock x:Name="FastSingingHint" Style="{StaticResource Label}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="EngineOptionsCard" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Ui011}" Style="{StaticResource Label}"/>
                                <ComboBox x:Name="EngineCombo" SelectionChanged="Engine_Changed" Margin="0,0,0,16">
                                    <ComboBoxItem Content="{DynamicResource Ui012}" Tag="DeepFilterNet3"/>
                                    <ComboBoxItem Content="{DynamicResource Ui013}" Tag="RNNoise"/>
                                </ComboBox>
                                <TextBlock Text="{DynamicResource Ui014}" Style="{StaticResource Label}"/>
                                <ComboBox x:Name="BufferModeCombo" SelectionChanged="BufferMode_Changed">
                                    <ComboBoxItem Content="{DynamicResource Ui015}"/>
                                    <ComboBoxItem Content="{DynamicResource Ui016}"/>
                                    <ComboBoxItem Content="{DynamicResource Ui017}"/>
                                    <ComboBoxItem Content="{DynamicResource AutomaticMode}"/>
                                </ComboBox>
                                <TextBlock x:Name="BufferHint" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,9,0,0"/>
                                <TextBlock Text="{DynamicResource Ui018}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="11"/>
                            </StackPanel>
                        </Border>
                    <Border x:Name="QuickLevelsCard" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource QuickLevels}" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Text="{DynamicResource Ui041}" Style="{StaticResource Label}"/>
                                        <Slider Minimum="-12" Maximum="18" Value="{Binding Value, ElementName=InputGainSlider, Mode=TwoWay}"/>
