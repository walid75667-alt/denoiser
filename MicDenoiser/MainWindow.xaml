<Window x:Class="MicDenoiser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mic Denoiser" Width="540" Height="840" MinHeight="620" MinWidth="460"
        FlowDirection="RightToLeft" FontFamily="Segoe UI"
        Background="{StaticResource Surface}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═════════ Header ═════════ -->
        <Border Grid.Row="0" Background="{StaticResource Ink}" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Mic Denoiser" Foreground="White" FontSize="22" FontWeight="Bold"
                               FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                    <TextBlock Text="عزل ضوضاء مع الحفاظ على طبيعية الكلام" Foreground="#9AA3B2" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#232733" CornerRadius="14" Padding="12,6"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#6B7280"
                                 VerticalAlignment="Center" Margin="0,0,0,0"/>
                        <TextBlock x:Name="StatusPill" Text="متوقف" Foreground="White" FontSize="12"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═════════ Body ═════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,18,20,8">

                <!-- Devices -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="الأجهزة"/>
                        <TextBlock Style="{StaticResource Label}" Text="المايك الحقيقي"/>
                        <ComboBox x:Name="InputCombo" Margin="0,0,0,12" Padding="6"/>
                        <TextBlock Style="{StaticResource Label}" Text="المخرج (اختر CABLE Input)"/>
                        <ComboBox x:Name="OutputCombo" Padding="6"/>
                        <TextBlock Style="{StaticResource Label}" Text="محرّك العزل" Margin="0,12,0,4"/>
                        <ComboBox x:Name="EngineCombo" SelectionChanged="Engine_Changed" Padding="6">
                            <ComboBoxItem Content="DeepFilterNet3 — جودة عالية" Tag="DeepFilterNet3"/>
                            <ComboBoxItem Content="RNNoise — خفيف" Tag="RNNoise"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Meters -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="المستويات"/>

                        <TextBlock Style="{StaticResource Label}" Text="الدخل (المايك)"/>
                        <Border x:Name="InTrack" Height="12" CornerRadius="6" ClipToBounds="True"
                                Background="{StaticResource Track}" Margin="0,0,0,12" FlowDirection="LeftToRight">
                            <Grid>
                                <Border>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#12B5A0" Offset="0"/>
                                            <GradientStop Color="#12B5A0" Offset="0.65"/>
                                            <GradientStop Color="#F5A524" Offset="0.85"/>
                                            <GradientStop Color="#E5484D" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border x:Name="InMask" Background="{StaticResource Track}"
                                        HorizontalAlignment="Right" Width="9999"/>
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource Label}" Text="الخرج (بعد العزل)"/>
                        <Border x:Name="OutTrack" Height="12" CornerRadius="6" ClipToBounds="True"
                                Background="{StaticResource Track}" Margin="0,0,0,12" FlowDirection="LeftToRight">
                            <Grid>
                                <Border>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#12B5A0" Offset="0"/>
                                            <GradientStop Color="#12B5A0" Offset="0.65"/>
                                            <GradientStop Color="#F5A524" Offset="0.85"/>
                                            <GradientStop Color="#E5484D" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border x:Name="OutMask" Background="{StaticResource Track}"
                                        HorizontalAlignment="Right" Width="9999"/>
                            </Grid>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="VoiceDot" Width="9" Height="9" Fill="#C5CBD6" VerticalAlignment="Center"/>
                                <TextBlock x:Name="VoiceText" Text="في الانتظار" Style="{StaticResource Label}"
                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="GateText" Grid.Column="1" Style="{StaticResource Value}" Text=""/>
                        </Grid>
                        <TextBlock x:Name="PerformanceText" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Presets -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="الإعداد المسبق"/>
                        <WrapPanel x:Name="PresetPanel">
                            <RadioButton Style="{StaticResource PresetButton}" GroupName="preset" Tag="natural"
                                         Content="طبيعي" Checked="Preset_Checked"/>
                            <RadioButton Style="{StaticResource PresetButton}" GroupName="preset" Tag="studio"
                                         Content="استوديو" IsChecked="True" Checked="Preset_Checked"/>
                            <RadioButton Style="{StaticResource PresetButton}" GroupName="preset" Tag="podcast"
                                         Content="بودكاست" Checked="Preset_Checked"/>
                            <RadioButton Style="{StaticResource PresetButton}" GroupName="preset" Tag="max"
                                         Content="أقصى عزل" Checked="Preset_Checked"/>
                        </WrapPanel>
                        <TextBlock x:Name="PresetHint" Style="{StaticResource Label}" TextWrapping="Wrap"
                                   Text="عزل من غير مؤثرات إضافية؛ نقطة البداية للمقارنة."/>
                        <CheckBox x:Name="BypassCheck" Margin="0,10,0,0" Click="Param_Clicked"
                                  Content="تجاوز المعالجة (للمقارنة بين الأصلي والمعالَج)"/>
                    </StackPanel>
                </Border>

                <!-- Main controls -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="التحكم"/>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="قوة عزل الضوضاء"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource Value}"
                                       Text="{Binding Value, ElementName=StrengthSlider, StringFormat={}{0:0}%}"/>
                        </Grid>
                        <Slider x:Name="StrengthSlider" Minimum="0" Maximum="100" ValueChanged="Param_Changed"/>

                        <CheckBox x:Name="GateEnabledCheck" Click="Param_Clicked" Margin="0,0,0,8"
                                  Content="تفعيل بوابة الكلام (اختيارية؛ قد تؤثر على الهمس)"/>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="صرامة بوابة الصوت (أعلى = يقطع الهمس والضوضاء أكثر)"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource Value}"
                                       Text="{Binding Value, ElementName=GateSlider, StringFormat={}{0:0}%}"/>
                        </Grid>
                        <Slider x:Name="GateSlider" Minimum="0" Maximum="100" ValueChanged="Param_Changed"/>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Label}" Text="عمق البوابة (كتم الضوضاء بين الكلمات)"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource Value}"
                                       Text="{Binding Value, ElementName=GateDepthSlider, StringFormat={}{0:0} dB}"/>
                        </Grid>
                        <Slider x:Name="GateDepthSlider" Minimum="0" Maximum="60" ValueChanged="Param_Changed"/>

                    </StackPanel>
                </Border>

                <!-- Advanced -->
                <Border Style="{StaticResource Card}">
                    <Expander Header="إعدادات متقدمة" FontWeight="SemiBold">
                        <StackPanel Margin="0,12,0,0" TextElement.FontWeight="Normal">

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Label}" Text="تضخيم الدخل"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource Value}"
                                           Text="{Binding Value, ElementName=InputGainSlider, StringFormat={}{0:+0;-0;0} dB}"/>
                            </Grid>
                            <Slider x:Name="InputGainSlider" Minimum="-12" Maximum="18" ValueChanged="Param_Changed"/>
                            <CheckBox x:Name="HighPassCheck" Click="Param_Clicked" Margin="0,0,0,10"
                                      Content="فلتر اهتزازات وترددات منخفضة (70Hz)"/>

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Label}" Text="وضوح الصوت (Presence 3.5 kHz)"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource Value}"
                                           Text="{Binding Value, ElementName=PresenceSlider, StringFormat={}{0:0.0} dB}"/>
                            </Grid>
                            <Slider x:Name="PresenceSlider" Minimum="0" Maximum="6" ValueChanged="Param_Changed"/>

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Label}" Text="تقليل الطنين (Mud 280 Hz)"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource Value}"
                                           Text="{Binding Value, ElementName=MudSlider, StringFormat={}{0:0.0} dB}"/>
                            </Grid>
                            <Slider x:Name="MudSlider" Minimum="0" Maximum="6" ValueChanged="Param_Changed"/>

                            <CheckBox x:Name="CompCheck" Margin="0,0,0,10" Click="Param_Clicked"
                                      Content="ضاغط ديناميكي (يوازن بين الهمس والصراخ)"/>

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Label}" Text="عتبة الضاغط"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource Value}"
                                           Text="{Binding Value, ElementName=CompThresholdSlider, StringFormat={}{0:0} dB}"/>
                            </Grid>
                            <Slider x:Name="CompThresholdSlider" Minimum="-40" Maximum="-6" ValueChanged="Param_Changed"/>

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Label}" Text="نسبة الضغط"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource Value}"
                                           Text="{Binding Value, ElementName=CompRatioSlider, StringFormat={}{0:0.0}:1}"/>
                            </Grid>
                            <Slider x:Name="CompRatioSlider" Minimum="1.5" Maximum="8" ValueChanged="Param_Changed"/>

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Label}" Text="مستوى الخرج"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource Value}"
                                           Text="{Binding Value, ElementName=OutputGainSlider, StringFormat={}{0:+0;-0;0} dB}"/>
                            </Grid>
                            <Slider x:Name="OutputGainSlider" Minimum="-12" Maximum="12" ValueChanged="Param_Changed"/>
                        </StackPanel>
                    </Expander>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ═════════ Footer ═════════ -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
                Padding="20,14">
            <StackPanel>
                <Button x:Name="ToggleButton" Style="{StaticResource PrimaryButton}" Height="46"
                        Content="ابدأ العزل" Click="ToggleButton_Click"/>
                <TextBlock x:Name="StatusText" Style="{StaticResource Label}" Margin="0,10,0,0"
                           TextWrapping="Wrap" Text="جاهز."/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
