                                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="8" CornerRadius="8" Margin="3">
                                                <StackPanel>
                                                    <TextBlock Text="{DynamicResource EqBody}" Style="{StaticResource CardTitle}"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{DynamicResource GainDb}" Style="{StaticResource Label}"/>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBox FlowDirection="LeftToRight" Width="54" Padding="4,2" Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Line}" KeyDown="MixerNumber_KeyDown" Text="{Binding Value, ElementName=EqBodyGainSlider, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, StringFormat={}{0:0.0}}"/>
                                                        </StackPanel>
