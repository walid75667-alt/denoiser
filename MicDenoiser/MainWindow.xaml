                                                        </StackPanel>
                                                    </Grid>
                                                    <Slider x:Name="EqPresenceQSlider" Minimum="0.35" Maximum="3" ValueChanged="Param_Changed"/>
                                                </StackPanel></Expander></StackPanel>
                                            </Border>
                                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="8" CornerRadius="8" Margin="3">
                                                <StackPanel>
                                                    <TextBlock Text="{DynamicResource EqAir}" Style="{StaticResource CardTitle}"/>
                                                    <Grid>
