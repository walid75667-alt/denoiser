                                        <TextBlock Text="{DynamicResource QuickOutputGain}" Style="{StaticResource Label}"/>
                                        <Slider Minimum="-12" Maximum="12" Value="{Binding Value, ElementName=OutputGainSlider, Mode=TwoWay}"/>
                                        <TextBlock FlowDirection="LeftToRight" Style="{StaticResource Value}" Text="{Binding Value, ElementName=OutputGainSlider, StringFormat={}{0:0.0} dB}"/>
                                        <TextBlock Text="{DynamicResource QuickLevelsHint}" Style="{StaticResource Label}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Ui027}" Style="{StaticResource CardTitle}"/>
                                        <WrapPanel x:Name="PresetPanel">
                                            <RadioButton Style="{StaticResource PresetButton}" GroupName="preset" Tag="natural" Content="{DynamicResource Ui028}" Checked="Preset_Checked"/>
                                            <RadioButton Style="{StaticResource PresetButton}" GroupName="preset" Tag="studio" Content="{DynamicResource Ui029}" IsChecked="True" Checked="Preset_Checked"/>
                                            <RadioButton Style="{StaticResource PresetButton}" GroupName="preset" Tag="podcast" Content="{DynamicResource Ui030}" Checked="Preset_Checked"/>
                                            <RadioButton Style="{StaticResource PresetButton}" GroupName="preset" Tag="max" Content="{DynamicResource Ui031}" Checked="Preset_Checked"/>
                                            <RadioButton Style="{StaticResource PresetButton}" GroupName="preset" Tag="calls" Content="{DynamicResource CallsPreset}" Checked="Preset_Checked"/>
                                            <RadioButton Style="{StaticResource PresetButton}" GroupName="preset" Tag="streaming" Content="{DynamicResource StreamingPreset}" Checked="Preset_Checked"/>
                                            <RadioButton Style="{StaticResource PresetButton}" GroupName="preset" Tag="weakmic" Content="{DynamicResource WeakMicPreset}" Checked="Preset_Checked"/>
                                            <RadioButton Style="{StaticResource PresetButton}" GroupName="preset" Tag="whisper" Content="{DynamicResource WhisperPreset}" Checked="Preset_Checked"/>
                                            <RadioButton Style="{StaticResource PresetButton}" GroupName="preset" Tag="singing" Content="{DynamicResource SingingPreset}" Checked="Preset_Checked"/>
                                            <RadioButton Style="{StaticResource PresetButton}" GroupName="preset" Tag="voiceover" Content="{DynamicResource VoiceOverPreset}" Checked="Preset_Checked"/>
                                            <RadioButton Style="{StaticResource PresetButton}" GroupName="preset" Tag="broadcast" Content="{DynamicResource BroadcastPreset}" Checked="Preset_Checked"/>
                                            <RadioButton Style="{StaticResource PresetButton}" GroupName="preset" Tag="vocalroom" Content="{DynamicResource VocalRoomPreset}" Checked="Preset_Checked"/>
                                            <RadioButton Style="{StaticResource PresetButton}" GroupName="preset" Tag="vocalhall" Content="{DynamicResource VocalHallPreset}" Checked="Preset_Checked"/>
                                            <RadioButton Style="{StaticResource PresetButton}" GroupName="preset" Tag="slapback" Content="{DynamicResource SlapbackPreset}" Checked="Preset_Checked"/>
                                        </WrapPanel>
                                        <TextBlock x:Name="PresetHint" Style="{StaticResource Label}" TextWrapping="Wrap"/>
                                        <WrapPanel Margin="0,12,0,0">
                                            <Button Content="{DynamicResource Ui032}" Style="{StaticResource SecondaryButton}" Click="SofterSound_Click" Margin="0,0,8,8" ToolTip="{DynamicResource Ui033}"/>
                                            <Button Content="{DynamicResource Ui034}" Style="{StaticResource SecondaryButton}" Click="ResetAudio_Click" Margin="0,0,0,8"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource Ui035}" Style="{StaticResource CardTitle}"/>
                                            <TextBlock Grid.Column="1" Style="{StaticResource Value}" Text="{Binding Value, ElementName=NoiseLimitSlider, StringFormat={}{0:0} dB}"/>
                                        </Grid>
                                        <Slider x:Name="NoiseLimitSlider" Minimum="10" Maximum="60" ValueChanged="Param_Changed"/>
                                        <TextBlock Text="{DynamicResource Ui036}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource Ui037}" Style="{StaticResource Label}"/>
                                            <TextBlock Grid.Column="1" Style="{StaticResource Value}" Text="{Binding Value, ElementName=StrengthSlider, StringFormat={}{0:0}%}"/>
                                        </Grid>
                                        <Slider x:Name="StrengthSlider" Minimum="0" Maximum="100" ValueChanged="Param_Changed"/>
                                        <CheckBox x:Name="BypassCheck" Click="Param_Clicked" Content="{DynamicResource Ui038}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem x:Name="MixerTab" Header="{DynamicResource Ui039}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="CustomOptions" Margin="0,14,0,0">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource MixerTitle}" Style="{StaticResource CardTitle}"/>
                                        <TextBlock Text="{DynamicResource MixerHint}" Style="{StaticResource Label}"/>
                                        <Border Background="{DynamicResource AccentSoft}" Padding="12" CornerRadius="8" Margin="0,8,0,14">
                                            <TextBlock Text="{DynamicResource SignalChain}" TextWrapping="Wrap" Foreground="{DynamicResource Accent}"/>
                                        </Border>
                                        <WrapPanel>
                                            <Button Content="{DynamicResource SaveEffects}" Click="SaveEffects_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                                            <Button Content="{DynamicResource LoadEffects}" Click="LoadEffects_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource EqTitle}" Style="{StaticResource CardTitle}"/>
                                        <Button Content="{DynamicResource ResetModule}" Tag="eq" Click="ModuleReset_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,8,0,8"/><CheckBox x:Name="EqEnabledCheck" Content="{DynamicResource EqEnable}" Click="Param_Clicked" Margin="0,0,0,10"/>
                                        <local:EqCurve x:Name="EqPlot" Height="160" FlowDirection="LeftToRight"/>
                                        <TextBlock Text="{DynamicResource EqCurveHint}" Style="{StaticResource Label}"/>
                                        <UniformGrid x:Name="EqBandGrid" Columns="4" Margin="0,12,0,0" SizeChanged="EqBandGrid_SizeChanged">
                                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="8" CornerRadius="8" Margin="3">
                                                <StackPanel>
                                                    <TextBlock Text="{DynamicResource EqLow}" Style="{StaticResource CardTitle}"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{DynamicResource GainDb}" Style="{StaticResource Label}"/>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBox FlowDirection="LeftToRight" Width="54" Padding="4,2" Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Line}" KeyDown="MixerNumber_KeyDown" Text="{Binding Value, ElementName=EqLowGainSlider, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, StringFormat={}{0:0.0}}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <Slider x:Name="EqLowGainSlider" Minimum="-9" Maximum="9" ValueChanged="Param_Changed" Orientation="Vertical" Height="100" HorizontalAlignment="Center" Width="36"/>
                                                    <Expander Header="{DynamicResource Advanced}" Foreground="{DynamicResource Ink}"><StackPanel Margin="0,8,0,0"><Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{DynamicResource Frequency}" Style="{StaticResource Label}"/>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBox FlowDirection="LeftToRight" Width="54" Padding="4,2" Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Line}" KeyDown="MixerNumber_KeyDown" Text="{Binding Value, ElementName=EqLowHzSlider, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, StringFormat={}{0:0}}"/>
                                                        </StackPanel>
