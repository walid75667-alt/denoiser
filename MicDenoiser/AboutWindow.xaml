<Window x:Class="MicDenoiser.AboutWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{DynamicResource About}" Width="420" Height="460" MinWidth="360" MinHeight="360" WindowStartupLocation="CenterOwner" Background="{DynamicResource Surface}" FontFamily="{DynamicResource InterfaceFont}">
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28">
<Image Source="/Assets/MicDenoiser.png" Width="72" Height="72" Margin="0,0,0,16"/>
<TextBlock Text="MicDenoiser" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" HorizontalAlignment="Center" FlowDirection="LeftToRight"/>
<TextBlock x:Name="VersionText" Style="{StaticResource Label}" HorizontalAlignment="Center" Margin="0,8,0,20" FlowDirection="LeftToRight"/>
<TextBlock Text="{DynamicResource DesignedBy}" TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource CardTitle}"/>
<Button Content="WhatsApp · 01033397772" Tag="https://wa.me/201033397772" Click="Link_Click" Style="{StaticResource SecondaryButton}" Margin="0,8" FlowDirection="LeftToRight"/>
<Button Content="Facebook · /egbrave" Tag="https://www.facebook.com/egbrave" Click="Link_Click" Style="{StaticResource SecondaryButton}" Margin="0,8" FlowDirection="LeftToRight"/>
<TextBlock Text="{DynamicResource AboutLocal}" Style="{StaticResource Label}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,18,0,0"/>
<TextBlock x:Name="ErrorText" Style="{StaticResource Label}" TextWrapping="Wrap"/>
</StackPanel></ScrollViewer></Window>
