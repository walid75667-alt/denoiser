<Window x:Class="MicDenoiser.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource SetupTitle}" Width="720" Height="620" MinWidth="580" MinHeight="470"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Surface}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="{DynamicResource SetupTitle}" Style="{StaticResource CardTitle}"/>
            <TextBlock Text="{DynamicResource SetupIntro}" Style="{StaticResource Label}" TextWrapping="Wrap"/>
            <Border Style="{StaticResource Card}" Margin="0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource SetupFlowTitle}" Style="{StaticResource CardTitle}"/>
                    <WrapPanel HorizontalAlignment="Center">
                        <Border Background="{DynamicResource AccentSoft}" CornerRadius="8" Padding="16" Margin="4">
                            <StackPanel><TextBlock Text="🎙" FontSize="24" HorizontalAlignment="Center"/><TextBlock Text="{DynamicResource SetupMic}" Style="{StaticResource Label}"/></StackPanel>
                        </Border>
                        <TextBlock Text="{DynamicResource SetupArrow}" FontSize="24" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                        <Border Background="{DynamicResource AccentSoft}" CornerRadius="8" Padding="16" Margin="4">
                            <StackPanel><TextBlock Text="MicDenoiser" FontWeight="Bold"/><TextBlock Text="CABLE Input" Style="{StaticResource Label}" FlowDirection="LeftToRight"/></StackPanel>
                        </Border>
                        <TextBlock Text="{DynamicResource SetupArrow}" FontSize="24" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                        <Border Background="{DynamicResource AccentSoft}" CornerRadius="8" Padding="16" Margin="4">
                            <StackPanel><TextBlock Text="Zoom / OBS / Discord" FontWeight="Bold"/><TextBlock Text="CABLE Output" Style="{StaticResource Label}" FlowDirection="LeftToRight"/></StackPanel>
                        </Border>
                    </WrapPanel>
                    <TextBlock Text="{DynamicResource SetupRoute}" Style="{StaticResource Label}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="CableStatus" Style="{StaticResource CardTitle}" TextWrapping="Wrap"/>
            <TextBlock Text="{DynamicResource SetupInstall}" Style="{StaticResource Label}" TextWrapping="Wrap"/>
            <WrapPanel Margin="0,12">
                <Button Content="{DynamicResource SetupVendor}" Click="Vendor_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                <Button Content="{DynamicResource SetupDetect}" Click="Detect_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8"/>
            </WrapPanel>
            <TextBlock Text="{DynamicResource SetupHeadphones}" Style="{StaticResource Label}" TextWrapping="Wrap"/>
            <Button Content="{DynamicResource SetupDone}" Click="Done_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,16,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Window>
