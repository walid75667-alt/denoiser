<Window x:Class="MicDenoiser.SetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{DynamicResource SetupTitle}" Width="440" Height="690" MinWidth="400" MinHeight="540" WindowStartupLocation="CenterOwner" Background="{DynamicResource Surface}" FontFamily="{DynamicResource InterfaceFont}">
<Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="{DynamicResource SetupTitle}" Style="{StaticResource CardTitle}" FontSize="22"/><ProgressBar x:Name="StepProgress" Maximum="3" Height="5" Margin="0,4,0,16" Foreground="{DynamicResource Accent}"/></StackPanel>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
<StackPanel x:Name="StepOne">
<TextBlock Text="{DynamicResource WizardStep1}" Style="{StaticResource CardTitle}"/>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="CableStatus" Style="{StaticResource CardTitle}" TextWrapping="Wrap"/><TextBlock Text="{DynamicResource SetupInstall}" Style="{StaticResource Label}" TextWrapping="Wrap"/><Button Content="{DynamicResource SetupVendor}" Click="Vendor_Click" Style="{StaticResource SecondaryButton}" Margin="0,12,0,8"/><Button Content="{DynamicResource SetupDetect}" Click="Detect_Click" Style="{StaticResource SecondaryButton}"/></StackPanel></Border>
<TextBlock Text="{DynamicResource WizardOptional}" Style="{StaticResource Label}" TextWrapping="Wrap"/>
<TextBlock Text="{DynamicResource UsagePurpose}" Style="{StaticResource CardTitle}" Margin="0,18,0,8"/>
<ComboBox x:Name="PurposeCombo"><ComboBoxItem Content="{DynamicResource UsageCalls}"/><ComboBoxItem Content="{DynamicResource UsageStudio}"/></ComboBox>
</StackPanel>
<StackPanel x:Name="StepTwo" Visibility="Collapsed">
<TextBlock Text="{DynamicResource WizardStep2}" Style="{StaticResource CardTitle}"/><TextBlock Text="{DynamicResource WizardMicHint}" Style="{StaticResource Label}" TextWrapping="Wrap"/>
<ComboBox x:Name="MicrophoneCombo" SelectionChanged="Microphone_Changed" Margin="0,16,0,12"/>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource Ui023}" Style="{StaticResource Label}"/><ProgressBar x:Name="MicMeter" Maximum="1" Height="12" Foreground="{DynamicResource Accent}"/><TextBlock x:Name="MicLevel" Text="— dBFS" Style="{StaticResource Value}" Margin="0,8,0,0"/></StackPanel></Border>
<TextBlock Text="{DynamicResource Ui007}" Style="{StaticResource Label}"/><ComboBox x:Name="RoutingCombo" Margin="0,0,0,12"/>
<TextBlock Text="{DynamicResource PreviewDevice}" Style="{StaticResource Label}"/><ComboBox x:Name="HeadphonesCombo"/>
<TextBlock Text="{DynamicResource SetupHeadphones}" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,12,0,0"/>
</StackPanel>
<StackPanel x:Name="StepThree" Visibility="Collapsed">
<TextBlock Text="{DynamicResource WizardStep3}" Style="{StaticResource CardTitle}"/><TextBlock Text="{DynamicResource WizardTestHint}" Style="{StaticResource Label}" TextWrapping="Wrap"/>
<Button x:Name="RecordButton" Content="{DynamicResource WizardRecord}" Click="Record_Click" Style="{StaticResource PrimaryButton}" Height="42" Margin="0,14"/>
<ProgressBar x:Name="RecordingProgress" Maximum="10" Height="8"/>
<UniformGrid Rows="1" Margin="0,12"><Button x:Name="OriginalButton" Content="{DynamicResource PlayOriginal}" Tag="original" Click="Play_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,4,0" IsEnabled="False"/><Button x:Name="ProcessedButton" Content="{DynamicResource PlayProcessed}" Tag="processed" Click="Play_Click" Style="{StaticResource SecondaryButton}" IsEnabled="False"/></UniformGrid>
<Button Content="{DynamicResource PreviewStop}" Click="StopPlay_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,0,12"/>
<TextBlock Text="{DynamicResource WizardRouteTitle}" Style="{StaticResource CardTitle}" Margin="0,16,0,8"/>
<Border Style="{StaticResource Card}" Background="{DynamicResource AccentSoft}"><StackPanel>
<TextBlock Text="🎙  →  MicDenoiser  →  CABLE Input" FlowDirection="LeftToRight" Foreground="{DynamicResource Ink}" FontWeight="SemiBold" TextWrapping="Wrap"/>
<TextBlock Text="↓" HorizontalAlignment="Center" FontSize="24" Foreground="{DynamicResource Accent}"/>
<TextBlock Text="Zoom / Discord / OBS" HorizontalAlignment="Center" Foreground="{DynamicResource Ink}"/>
<Border Background="{DynamicResource CardBg}" CornerRadius="8" Padding="12" Margin="0,8"><TextBlock Text="🎙  CABLE Output   ▾" FlowDirection="LeftToRight" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/></Border>
</StackPanel></Border>
<TextBlock Text="{DynamicResource WizardRouteZoom}" Style="{StaticResource Label}" TextWrapping="Wrap"/><TextBlock Text="{DynamicResource WizardRouteDiscord}" Style="{StaticResource Label}" TextWrapping="Wrap"/><TextBlock Text="{DynamicResource WizardRouteObs}" Style="{StaticResource Label}" TextWrapping="Wrap"/>
</StackPanel>
<TextBlock x:Name="StatusText" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,12"/>
</StackPanel></ScrollViewer>
<Grid Grid.Row="2" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="BackButton" Content="{DynamicResource Back}" Click="Back_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/><Button x:Name="NextButton" Grid.Column="1" Content="{DynamicResource Next}" Click="Next_Click" Style="{StaticResource PrimaryButton}" Height="40"/></Grid>
</Grid></Window>
